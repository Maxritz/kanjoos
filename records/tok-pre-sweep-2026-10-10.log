pattern[qwen2] = "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p{L}\\p{N}]?\\p{L}+|\\p{N}| ?[^\\s\\p{L}\\p{N}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+"
pattern[qwen35] = "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p{L}\\p{N}]?[\\p{L}\\p{M}]+|\\p{N}| ?[^\\s\\p{L}\\p{M}\\p{N}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+"

contr-lower        qwen2  "don't" -> ['don', "'t"]
contr-lower        qwen35 "don't" -> ['don', "'t"]
contr-upper        qwen2  "DON'T" -> ['DON', "'T"]
contr-upper        qwen35 "DON'T" -> ['DON', "'T"]
contr-ve           qwen2  "they've" -> ['they', "'ve"]
contr-ll           qwen2  "I'll" -> ['I', "'ll"]
contr-re           qwen2  "we're" -> ['we', "'re"]
contr-non          qwen2  "rock 'n' roll" -> ['rock', " '", 'n', "'", ' roll']
contr-trail        qwen2  "cats'" -> ['cats', "'"]
contr-dbl          qwen2  "''s" -> ["''", 's']
contr-s            qwen2  "'s" -> ["'s"]
letter-plain       qwen2  'hello' -> ['hello']
letter-plain       qwen35 'hello' -> ['hello']
letter-space       qwen2  'Hello World' -> ['Hello', ' World']
letter-digit-split qwen2  'a1b' -> ['a', '1', 'b']
letter-digit-run   qwen2  'abc123' -> ['abc', '1', '2', '3']
digit-letter       qwen2  '123abc' -> ['1', '2', '3', 'abc']
digit-prefix-no    qwen2  '1a' -> ['1', 'a']
letter-lead-space  qwen2  ' a' -> [' a']
underscore         qwen2  'under_score' -> ['under', '_score']
hyphen             qwen2  'co-op' -> ['co', '-op']
number-run         qwen2  '123' -> ['1', '2', '3']
number-dot         qwen2  '3.14' -> ['3', '.', '1', '4']
punct-run          qwen2  '!!!' -> ['!!!']
punct-lead-space   qwen2  ' !!!' -> [' !!!']
punct-crlf         qwen2  '!?\n!\n' -> ['!?\n', '!\n']
punct-word         qwen2  'a!b' -> ['a', '!b']
punct-emdash       qwen2  '—' -> ['—']
punct-cjk          qwen2  '。' -> ['。']
punct-cjk-word     qwen2  'a。b' -> ['a', '。b']
newline-mid        qwen2  'a\nb' -> ['a', '\n', 'b']
newline-space      qwen2  'a \n b' -> ['a', ' \n', ' b']
newline-crlf       qwen2  'a\r\n\r\nb' -> ['a', '\r\n\r\n', 'b']
cjk-letters        qwen2  '日本語' -> ['日本語']
cjk-letters        qwen35 '日本語' -> ['日本語']
emoji              qwen2  '🚀' -> ['🚀']
emoji-word         qwen2  'a🚀b' -> ['a', '🚀b']
mark-qwen2         qwen2  'áb' -> ['a', '́b']
mark-qwen35        qwen35 'áb' -> ['áb']
trail-one          qwen2  'hi ' -> ['hi', ' ']
trail-two          qwen2  'hi  ' -> ['hi', '  ']
lead-two           qwen2  '  hi' -> [' ', ' hi']
mid-two            qwen2  'a  b' -> ['a', ' ', ' b']
